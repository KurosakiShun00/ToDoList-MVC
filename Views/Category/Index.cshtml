@model List<ToDoList_MVC.ViewModels.Category.CategoryDetailsViewModel>;

@{
    ViewData["Title"] = "Lista Categorie";
    Layout = "_Layout";

    var totalCategories = Model.Count;
    var totalToDosAcrossCategories = Model.Sum(c => c.ToDoTotal);
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<form asp-controller="ToDoLists" method="post" id="batchForm">
    @Html.AntiForgeryToken()
</form>

@foreach (var line in Model)
{
    <form id="editForm-@line.Id" asp-controller="Category" asp-action="Edit" asp-route-id="@line.Id" method="post">
        @Html.AntiForgeryToken()
    </form>

    <form id="deleteForm-@line.Id" asp-controller="Category" asp-action="Delete" asp-route-id="@line.Id" method="post">
        @Html.AntiForgeryToken()
    </form>
}

<div class="container py-2">

    <div class="bg-white p-4 rounded-4 shadow-sm border mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <h2 class="h2 fw-bold text-dark mb-1">Le tue Categorie</h2>
                <p class="text-muted small mb-0">Personalizza i colori e organizza i tag delle tue attività</p>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-dark border fs-6 px-3 py-2 shadow-sm rounded-pill">
                    <span class="fw-bold text-primary">@totalCategories</span> categorie
                </span>

                <a asp-controller="Category" asp-action="Create" class="btn btn-primary fw-medium rounded-3 px-3"
                   role="button">
                    <i class="bi bi-plus-lg me-1"></i> Nuova Categoria
                </a>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 px-1">
        <div class="d-flex align-items-center gap-2">
            <div class="form-check me-2">
                <input type="checkbox" id="selectAll" class="form-check-input fs-5" title="Seleziona tutti"
                       style="cursor: pointer;"/>
                <label class="form-check-label text-muted small ms-1 align-middle fw-medium" for="selectAll">Seleziona
                    Tutti</label>
            </div>
        </div>

        <div id="batchActionsBar" class="d-none d-flex gap-2">
            <button type="submit"
                    form="batchForm"
                    formaction="@Url.Action("MultipleDelete", "Category")"
                    class="btn btn-sm btn-danger rounded-3"
                    onclick="return confirm('Sei sicuro di voler eliminare le categorie selezionate?');">
                <i class="bi bi-trash me-1"></i> Elimina Selezionate
            </button>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        @if (!Model.Any())
        {
            <div class="card-body text-center py-5">
                <i class="bi bi-tags fs-1 text-muted d-block mb-3"></i>
                <h5 class="fw-bold text-dark">Nessuna categoria trovata</h5>
                <p class="text-muted small">Crea una nuova categoria per iniziare ad organizzare le tue liste.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                    <tr class="text-uppercase small fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                        <th style="width: 40px;" class="ps-4"></th>
                        <th scope="col" style="width: 60px;">ID</th>
                        <th scope="col">Nome Categoria</th>
                        <th scope="col" class="text-center" style="width: 140px;">In Corso</th>
                        <th scope="col" class="text-center" style="width: 140px;">Completate</th>
                        <th scope="col" class="text-center" style="width: 120px;">Totali</th>
                        <th scope="col" class="text-center" style="width: 130px;">Colore</th>
                        <th scope="col" class="text-end pe-4" style="width: 80px;">Azioni</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var line in Model)
                    {
                        <tr style="--bs-table-bg: @line.Color;">
                            <td class="ps-4">
                                <input type="checkbox" name="selectedIds" value="@line.Id"
                                       form="batchForm"
                                       class="form-check-input list-checkbox fs-5"
                                       style="cursor: pointer;"
                                       title="Seleziona Categoria"/>
                            </td>
                            <td class="text-muted small fw-semibold">#@line.Id</td>
                            <td>
                                <input type="text"
                                       form="editForm-@line.Id"
                                       name="Name"
                                       value="@line.Name"
                                       class="form-control form-control-sm border-0 bg-transparent fw-medium text-dark"
                                       onmouseenter="if(document.activeElement!==this){ this.classList.remove('bg-transparent','border-0'); this.classList.add('bg-white','border'); }"
                                       onmouseleave="if(document.activeElement!==this){ this.classList.remove('bg-white','border'); this.classList.add('bg-transparent','border-0'); }"
                                       onfocus="this.classList.remove('bg-transparent','border-0'); this.classList.add('bg-white','border-primary','shadow-sm');"
                                       onblur="this.classList.remove('bg-white','border-primary','shadow-sm'); this.classList.add('bg-transparent','border-0');"
                                       onchange="document.getElementById('editForm-@line.Id').submit()"/>
                            </td>

                            <td class="text-center">
                                    <span
                                        class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1">
                                        @line.ToDoNotCompleted
                                    </span>
                            </td>

                            <td class="text-center">
                                    <span
                                        class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                        @line.ToDoCompleted
                                    </span>
                            </td>

                            <td class="text-center">
                                    <span
                                        class="badge bg-secondary-subtle text-dark border border-secondary-subtle rounded-pill px-3 py-1 fw-bold">
                                        @line.ToDoTotal
                                    </span>
                            </td>

                            <td class="text-center">
                                <div
                                    class="position-relative d-inline-flex align-items-center justify-content-center btn btn-sm btn-dark rounded-3 p-2 shadow-sm"
                                    title="Scegli colore" style="width: 42px; height: 34px;">
                                    <i class="bi bi-paint-bucket fs-6"></i>

                                    <input type="color"
                                           id="colorPicker-@line.Id"
                                           form="editForm-@line.Id"
                                           name="Color"
                                           value="@(string.IsNullOrEmpty(line.Color) ? "#ffffff" : line.Color)"
                                           class="position-absolute top-0 start-0 w-100 h-100 opacity-0 pe-auto"
                                           style="cursor: pointer;"
                                           onchange="document.getElementById('editForm-@line.Id').submit()"/>
                                </div>
                            </td>

                            <td class="text-end pe-4">
                                <button type="submit" form="deleteForm-@line.Id"
                                        class="btn btn-sm btn-outline-danger border-0 rounded-circle p-2 lh-1"
                                        title="Elimina Categoria">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="d-flex align-items-center justify-content-between pt-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-3 px-3" role="button">
            <i class="bi bi-arrow-left me-1"></i> Torna alla Home
        </a>
        <a asp-controller="Category" asp-action="Create" class="btn btn-primary rounded-3 px-3" role="button">
            <i class="bi bi-plus-lg me-1"></i> Aggiungi Categoria
        </a>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var popoverElement = document.querySelector('[data-bs-toggle="popover"]');
            if (popoverElement && typeof bootstrap !== 'undefined') {
                new bootstrap.Popover(popoverElement);
            }

            const checkboxes = document.querySelectorAll('.list-checkbox');
            const batchActionsBar = document.getElementById('batchActionsBar');
            const selectAll = document.getElementById('selectAll');

            function toggleBatchBar() {
                const checkedCount = document.querySelectorAll('.list-checkbox:checked').length;
                if (batchActionsBar) {
                    if (checkedCount > 0) {
                        batchActionsBar.classList.remove('d-none');
                    } else {
                        batchActionsBar.classList.add('d-none');
                    }
                }
            }

            checkboxes.forEach(box => {
                box.addEventListener('change', toggleBatchBar);
            });

            if (selectAll) {
                selectAll.addEventListener('change', function () {
                    checkboxes.forEach(box => {
                        box.checked = selectAll.checked;
                    });
                    toggleBatchBar();
                });
            }
        });
    </script>
}