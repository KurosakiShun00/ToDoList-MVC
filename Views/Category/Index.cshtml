@model List<ToDoList_MVC.ViewModels.Category.CategoryDetailsViewModel>;

@{
    ViewData["Title"] = "Lista Categorie";
    Layout = "_Layout";
    
}

<form asp-controller="ToDoLists" method="post" id="batchForm">
    @Html.AntiForgeryToken()
</form>

@foreach (var line in Model)
{
    <form id="editForm-@line.Id" asp-controller="Category" asp-action="EditCategory" asp-route-id="@line.Id" method="post">
        @Html.AntiForgeryToken()
    </form>

    <form id="deleteForm-@line.Id" asp-controller="Category" asp-action="DeleteCategory" asp-route-id="@line.Id" method="post">
        @Html.AntiForgeryToken()
    </form>
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center gap-2">
        <h2 class="display-4 m-0">Lista Categorie</h2>
        
    </div>

    <div id="batchActionsBar" class="d-none d-flex gap-2">
        <button type="submit" 
                form="batchForm"
                formaction="@Url.Action("MultipleCategoryDelete", "Category")" 
                class="btn btn-sm btn-danger"
                onclick="return confirm('Sei sicuro di voler eliminare le categorie selezionate?');">
             Elimina Selezionate
        </button>
    </div>
</div>

<table class="table align-middle">
    <thead class="table-dark">
        <tr>
            <th style="width: 5%;">
                <input type="checkbox" id="selectAll" class="form-check-input fs-5 mt-0" title="Seleziona tutte" />
            </th>
            <th scope="col" style="width: 10%;">Id</th>
            <th scope="col">Nome Categoria</th>
            <th scope="col" style="width: 15%;" class="text-center">Attività In Corso</th>
            <th scope="col" style="width: 15%;" class="text-end">Attività Completate</th>
            <th scope="col" style="width: 15%;" class="text-end">Attività Totali</th>
            <th scope="col" style="width: 15%;" class="text-end">Elimina Categoria</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var line in Model)
        {
            <tr>
                <td>
                    <input type="checkbox" name="selectedIds" value="@line.Id" 
                           form="batchForm"
                           class="form-check-input list-checkbox fs-5 mt-0 me-1" 
                           title="Seleziona Categoria" />
                </td>
                <td>@line.Id</td>
                <td>
                    <input type="text"
                           form="editForm-@line.Id"
                           name="Name"
                           value="@line.Name"
                           class="form-control form-control-sm bg-transparent border-0 shadow-none"
                           onmouseenter="if(document.activeElement!==this){ this.classList.remove('bg-transparent','border-0'); this.classList.add('bg-light','border-secondary-subtle'); }"
                           onmouseleave="if(document.activeElement!==this){ this.classList.remove('bg-light','border-secondary-subtle'); this.classList.add('bg-transparent','border-0'); }"
                           onfocus="this.classList.remove('bg-transparent','bg-light','border-0','border-secondary-subtle'); this.classList.add('bg-white','border-primary');"
                           onblur="this.classList.remove('bg-white','border-primary'); this.classList.add('bg-transparent','border-0');"
                           onchange="document.getElementById('editForm-@line.Id').submit()"/>
                </td>

                <td class="text-center">
                    @line.ToDoNotCompleted
                </td> 
                
                <td class="text-center">
                    @line.ToDoCompleted
                </td> 
                
                <td class="text-center">
                    @line.ToDoTotal
                </td>

                <td class="text-end">
                    <button type="submit" form="deleteForm-@line.Id" class="btn btn-danger btn-sm">
                        X
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>
<hr />

<div class="d-flex align-items-center justify-content-between mb-4 gap-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary" role="button">
        ← Torna alla Home
    </a>
    <div class="d-flex gap-2">
        <a asp-controller="Category" asp-action="CreateCategory" class="btn btn-primary" role="button">
            + Aggiungi Categoria
        </a>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var popoverElement = document.querySelector('[data-bs-toggle="popover"]');
            if (popoverElement && typeof bootstrap !== 'undefined') {
                new bootstrap.Popover(popoverElement);
            }

            const checkboxes = document.querySelectorAll('.list-checkbox');
            const batchActionsBar = document.getElementById('batchActionsBar');
            const selectAll = document.getElementById('selectAll');

            function toggleBatchBar() {
                const checkedCount = document.querySelectorAll('.list-checkbox:checked').length;
                if (batchActionsBar) {
                    if (checkedCount > 0) {
                        batchActionsBar.classList.remove('d-none');
                    } else {
                        batchActionsBar.classList.add('d-none');
                    }
                }
            }

            checkboxes.forEach(box => {
                box.addEventListener('change', toggleBatchBar);
            });

            if (selectAll) {
                selectAll.addEventListener('change', function () {
                    checkboxes.forEach(box => {
                        box.checked = selectAll.checked;
                    });
                    toggleBatchBar();
                });
            }
        });
    </script>
}