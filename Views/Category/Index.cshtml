@model List<ToDoList_MVC.ViewModels.Category.CategoryDetailsViewModel>;

@{
    ViewData["Title"] = "Lista Categorie";
    Layout = "_Layout";
}

<form asp-controller="ToDoLists" method="post" id="batchForm">
    @Html.AntiForgeryToken()
</form>

@foreach (var line in Model)
{
    <form id="editForm-@line.Id" asp-controller="Category" asp-action="EditCategory" asp-route-id="@line.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Name" value="@line.Name" />
    </form>

    <form id="deleteForm-@line.Id" asp-controller="Category" asp-action="DeleteCategory" asp-route-id="@line.Id" method="post">
        @Html.AntiForgeryToken()
    </form>
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center gap-2">
        <h2 class="display-4 m-0">Lista Categorie</h2>
    </div>

    <div id="batchActionsBar" class="d-none d-flex gap-2">
        <button type="submit" 
                form="batchForm"
                formaction="@Url.Action("MultipleCategoryDelete", "Category")" 
                class="btn btn-sm btn-danger"
                onclick="return confirm('Sei sicuro di voler eliminare le categorie selezionate?');">
             Elimina Selezionate
        </button>
    </div>
</div>

<table class="table align-middle">
    <thead class="table-dark">
        <tr>
            <th style="width: 5%;">
                <input type="checkbox" id="selectAll" class="form-check-input fs-5 mt-0" title="Seleziona tutte" />
            </th>
            <th scope="col" style="width: 10%;">Id</th>
            <th scope="col">Nome Categoria</th>
            <th scope="col" style="width: 15%;" class="text-center">Attività In Corso</th>
            <th scope="col" style="width: 15%;" class="text-center">Attività Completate</th>
            <th scope="col" style="width: 15%;" class="text-center">Attività Totali</th>
            <th scope="col" style="width: 15%;" class="text-center">Modifica Colore</th>
            <th scope="col" style="width: 15%;" class="text-end">Elimina Categoria</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var line in Model)
        {
            <tr style="--bs-table-bg: @line.Color">
                <td>
                    <input type="checkbox" name="selectedIds" value="@line.Id" 
                           form="batchForm"
                           class="form-check-input list-checkbox fs-5 mt-0 me-1" 
                           title="Seleziona Categoria" />
                </td>
                <td>@line.Id</td>
                <td>
                    <input type="text"
                           form="editForm-@line.Id"
                           name="Name"
                           value="@line.Name"
                           class="form-control form-control-sm bg-transparent border-0 shadow-none"
                           onmouseenter="if(document.activeElement!==this){ this.classList.remove('bg-transparent','border-0'); this.classList.add('bg-light','border-secondary-subtle'); }"
                           onmouseleave="if(document.activeElement!==this){ this.classList.remove('bg-light','border-secondary-subtle'); this.classList.add('bg-transparent','border-0'); }"
                           onfocus="this.classList.remove('bg-transparent','bg-light','border-0','border-secondary-subtle'); this.classList.add('bg-white','border-primary');"
                           onblur="this.classList.remove('bg-white','border-primary'); this.classList.add('bg-transparent','border-0');"
                           onchange="document.getElementById('editForm-@line.Id').submit()"/>
                </td>

                <td class="text-center">
                    @line.ToDoNotCompleted
                </td> 
                
                <td class="text-center">
                    @line.ToDoCompleted
                </td> 
                
                <td class="text-center">
                    @line.ToDoTotal
                </td>

                <td class="text-center">
                    <div class="position-relative d-inline-flex align-items-center justify-content-center btn btn-sm btn-dark p-2" title="Scegli colore" style="width: 40px; height: 32px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-paint-bucket" viewBox="0 0 16 16">
                            <path d="M6.192 2.78c-.458-.677-.927-1.248-1.35-1.643a3 3 0 0 0-.71-.515c-.217-.104-.56-.205-.882-.02-.367.213-.427.63-.43.896-.003.304.064.664.173 1.044.196.687.556 1.528 1.035 2.402L.752 8.22c-.277.277-.269.656-.218.918.055.283.187.593.36.903.348.627.92 1.361 1.626 2.068.707.707 1.441 1.278 2.068 1.626.31.173.62.305.903.36.262.05.64.059.918-.218l5.615-5.615c.118.257.092.512.05.939-.03.292-.068.665-.073 1.176v.123h.003a1 1 0 0 0 1.993 0H14v-.057a1 1 0 0 0-.004-.117c-.055-1.25-.7-2.738-1.86-3.494a4 4 0 0 0-.211-.434c-.349-.626-.92-1.36-1.627-2.067S8.857 3.052 8.23 2.704c-.31-.172-.62-.304-.903-.36-.262-.05-.64-.058-.918.219zM4.16 1.867c.381.356.844.922 1.311 1.632l-.704.705c-.382-.727-.66-1.402-.813-1.938a3.3 3.3 0 0 1-.131-.673q.137.09.337.274m.394 3.965c.54.852 1.107 1.567 1.607 2.033a.5.5 0 1 0 .682-.732c-.453-.422-1.017-1.136-1.564-2.027l1.088-1.088q.081.181.183.365c.349.627.92 1.361 1.627 2.068.706.707 1.44 1.278 2.068 1.626q.183.103.365.183l-4.861 4.862-.068-.01c-.137-.027-.342-.104-.608-.252-.524-.292-1.186-.8-1.846-1.46s-1.168-1.32-1.46-1.846c-.147-.265-.225-.47-.251-.607l-.01-.068zm2.87-1.935a2.4 2.4 0 0 1-.241-.561c.135.033.324.11.562.241.524.292 1.186.8 1.846 1.46.45.45.83.901 1.118 1.31a3.5 3.5 0 0 0-1.066.091 11 11 0 0 1-.76-.694c-.66-.66-1.167-1.322-1.458-1.847z"/>
                        </svg>
                        
                        <input type="color"
                               id="colorPicker-@line.Id"
                               form="editForm-@line.Id"
                               name="Color"
                               value="@(string.IsNullOrEmpty(line.Color) ? "#ffffff" : line.Color)"
                               class="position-absolute top-0 start-0 w-100 h-100 opacity-0 pe-auto"
                               style="cursor: pointer;"
                               onchange="document.getElementById('editForm-@line.Id').submit()" />
                    </div>
                </td>

                <td class="text-end">
                    <button type="submit" form="deleteForm-@line.Id" class="btn btn-danger btn-sm">
                        X
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>
<hr />

<div class="d-flex align-items-center justify-content-between mb-4 gap-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary" role="button">
        ← Torna alla Home
    </a>
    <div class="d-flex gap-2">
        <a asp-controller="Category" asp-action="Create" class="btn btn-primary" role="button">
            + Aggiungi Categoria
        </a>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var popoverElement = document.querySelector('[data-bs-toggle="popover"]');
            if (popoverElement && typeof bootstrap !== 'undefined') {
                new bootstrap.Popover(popoverElement);
            }

            const checkboxes = document.querySelectorAll('.list-checkbox');
            const batchActionsBar = document.getElementById('batchActionsBar');
            const selectAll = document.getElementById('selectAll');

            function toggleBatchBar() {
                const checkedCount = document.querySelectorAll('.list-checkbox:checked').length;
                if (batchActionsBar) {
                    if (checkedCount > 0) {
                        batchActionsBar.classList.remove('d-none');
                    } else {
                        batchActionsBar.classList.add('d-none');
                    }
                }
            }

            checkboxes.forEach(box => {
                box.addEventListener('change', toggleBatchBar);
            });

            if (selectAll) {
                selectAll.addEventListener('change', function () {
                    checkboxes.forEach(box => {
                        box.checked = selectAll.checked;
                    });
                    toggleBatchBar();
                });
            }
        });
    </script>
}