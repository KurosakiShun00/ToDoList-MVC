@model ToDoList_MVC.ViewModels.Shared.ErrorViewModel
@{
    ViewData["Title"] = ViewData["ErrorTitle"] ?? "Errore";
    Layout = "_Layout";
}

<div class="container my-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="text-danger display-5 mb-4 fw-bold">
                @ViewData["ErrorTitle"]
            </div>

            <p class="lead text-secondary mb-4">
                @ViewData["ErrorMessage"]
            </p>

            <div class="alert alert-secondary text-start shadow-sm p-4" role="alert">
                <h4 class="alert-heading h5 fw-bold text-dark mb-3">Informazioni per l'admin</h4>
                <p class="small text-secondary mb-0">
                    Segna il codice identificativo di seguito per ricevere assistenza tecnica
                </p>

                @if (Model.ShowRequestId)
                {
                    <hr>
                    <div class="d-flex align-items-center justify-content-between bg-light p-2 rounded border">
                        <span class="small fw-bold text-muted">ID Richiesta:</span>
                        <code class="text-danger fw-bold">@Model.RequestId</code>
                    </div>
                }
            </div>

            <div class="mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                    Torna alla Home
                </a>
            </div>
        </div>
    </div>
</div>