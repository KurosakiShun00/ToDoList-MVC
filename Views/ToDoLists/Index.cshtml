@model List<ToDoList_MVC.ViewModels.ToDoList.ToDoListsListViewModel>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

@{
    ViewData["Title"] = "Index";
    Layout = "_Layout";
    var filteredModel = ViewData["Filter"] != null
        ? ViewData["Filter"]!.Equals("Finished") ? Model.Where(x => x.IsFinished) : Model.Where(x => !x.IsFinished)
        : Model;
}

<form asp-controller="ToDoLists" asp-action="MultipleDelete" method="post" id="deleteMultipleForm">
    @Html.AntiForgeryToken()

    <div class="bg-white p-4 rounded-4 shadow-sm border mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <h2 class="h3 fw-bold text-dark mb-1">Le tue Liste</h2>
                <p class="text-muted small mb-0">Gestisci le tue attività e monitora i tuoi progressi</p>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-dark border fs-6 px-3 py-2 shadow-sm rounded-pill">
                    <span class="fw-bold text-primary">@Model.Count</span> / 30 liste
                </span>
                
                <a asp-controller="ToDoLists" asp-action="Create"
                   class="btn btn-primary fw-medium rounded-3 px-3 @(Model.Count >= 30 ? "disabled" : "")"
                   aria-disabled="@(Model.Count >= 30 ? "true" : "false")"
                   tabindex="@(Model.Count >= 30 ? "-1" : "0")"
                   role="button">
                    + Nuova Lista
                </a>

                <a asp-controller="Home" asp-action="Import"
                   class="btn btn-outline-secondary fw-medium rounded-3 px-3 @(Model.Count >= 30 ? "disabled" : "")"
                   aria-disabled="@(Model.Count >= 30 ? "true" : "false")"
                   tabindex="@(Model.Count >= 30 ? "-1" : "0")"
                   role="button">
                    <i class="bi bi-upload me-1"></i> Importa
                </a>
            </div>
        </div>

        <hr class="my-3 text-muted opacity-25" />

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="btn-group p-1 bg-light rounded-3 border" role="group">
                <a asp-controller="ToDoLists" asp-action="Index"
                   class="btn btn-sm rounded-2 border-0 fw-medium @(ViewData["Filter"] == null ? "bg-white shadow-sm text-primary" : "text-muted")">
                    Tutti
                </a>
                <a asp-controller="ToDoLists" asp-action="Index" asp-route-filter="Finished"
                   class="btn btn-sm rounded-2 border-0 fw-medium @((ViewData["Filter"] != null && ViewData["Filter"]!.Equals("Finished")) ? "bg-white shadow-sm text-primary" : "text-muted")">
                    Completate
                </a>
                <a asp-controller="ToDoLists" asp-action="Index" asp-route-filter="Not Finished"
                   class="btn btn-sm rounded-2 border-0 fw-medium @((ViewData["Filter"] != null && !ViewData["Filter"]!.Equals("Finished")) ? "bg-white shadow-sm text-primary" : "text-muted")">
                    In Corso
                </a>
            </div>

            <div id="batchActionButtons" class="d-none d-flex gap-2">
                <button type="submit" formaction="@Url.Action("MultipleFinished", "ToDoLists")" class="btn btn-sm btn-success rounded-3">
                    <i class="bi bi-check2-all me-1"></i> Segna Completate
                </button>
                <button type="submit" formaction="@Url.Action("MultipleNotFinished", "ToDoLists")" class="btn btn-sm btn-warning rounded-3">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Ripristina
                </button>
                <button type="submit" id="btnDeleteSelected" class="btn btn-sm btn-danger rounded-3" 
                        onclick="return confirm('Sei sicuro di voler eliminare le liste selezionate?');">
                    <i class="bi bi-trash me-1"></i> Elimina
                </button>
            </div>
        </div>
    </div>

    @if (!filteredModel.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5">
            <div class="card-body py-5">
                <i class="bi bi-journal-x fs-1 text-muted d-block mb-3"></i>
                <h5 class="fw-bold text-dark">Nessuna lista trovata</h5>
                <p class="text-muted small">Crea una nuova lista o importala per iniziare.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var ToDoList in filteredModel)
            {
                <div class="col d-flex">
                    <div class="card border border-light-subtle shadow-sm rounded-4 w-100 h-100 d-flex flex-column transition-all">
                        
                        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2 text-truncate me-2">
                                <input type="checkbox" name="selectedListIds" value="@ToDoList.Id" 
                                       class="form-check-input list-checkbox me-1" style="cursor: pointer;" 
                                       title="Seleziona lista" />
                                <h5 class="fw-bold text-dark mb-0 text-truncate" title="@ToDoList.Name">
                                    @ToDoList.Name
                                </h5>
                            </div>
                            
                            <a asp-controller="ToDoLists" asp-action="Edit" asp-route-id="@ToDoList.Id"
                               class="btn btn-sm btn-light rounded-circle text-muted p-2 lh-1 flex-shrink-0" title="Modifica">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </div>

                        <div class="px-4 pb-2">
                            @if (!ToDoList.IsFinished)
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">In corso</span>
                            }
                            else if (ToDoList.ToDos.Any())
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Completata</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill">Vuota</span>
                            }
                        </div>

                        <div class="card-body px-4 py-2 flex-grow-1 d-flex flex-column justify-content-center">
                            @if (ToDoList.ToDos.Count == 0)
                            {
                                <div class="text-center text-muted small py-4 bg-light rounded-3 border border-dashed my-auto">
                                    Nessuna attività presente
                                </div>
                            }
                            else
                            {
                                var totalToDos = ToDoList.ToDos.Count;
                                var completedToDos = ToDoList.ToDos.Count(t => t.IsCompleted);
                                var progressPct = totalToDos > 0 ? (completedToDos * 100) / totalToDos : 0;

                                <div class="w-100 my-auto">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="text-uppercase fw-semibold text-muted" style="font-size: 0.65rem; letter-spacing: 0.5px;">Progresso</span>
                                        <span class="small fw-bold text-dark" style="font-size: 0.75rem;">
                                            @completedToDos / @totalToDos
                                        </span>
                                    </div>

                                    <div class="progress mb-3" style="height: 4px;">
                                        <div class="progress-bar bg-primary" role="progressbar" style="width: @progressPct%" 
                                             aria-valuenow="@progressPct" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>

                                    <ul class="list-group list-group-flush small">
                                        @foreach (var toDo in ToDoList.ToDos.Take(3))
                                        {
                                            <li class="list-group-item px-0 py-1 bg-transparent border-0 d-flex align-items-center text-truncate">
                                                <i class="bi @(toDo.IsCompleted ? "bi-check-square-fill text-primary" : "bi-square text-muted") me-2"></i>
                                                <span class="@(toDo.IsCompleted ? "text-muted text-decoration-line-through" : "text-dark") text-truncate">
                                                    @toDo.Name
                                                </span>
                                            </li>
                                        }
                                    </ul>

                                    @if (ToDoList.ToDos.Count > 3)
                                    {
                                        <div class="text-end pt-1">
                                            <small class="text-muted fst-italic" style="font-size: 0.75rem;">+ altri @(ToDoList.ToDos.Count - 3)...</small>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="card-footer bg-transparent border-top border-light p-3 d-flex gap-2">
                            <a asp-controller="ToDoLists" asp-action="Details" asp-route-id="@ToDoList.Id"
                               class="btn btn-sm btn-primary rounded-3 flex-fill fw-medium" role="button">
                                Visualizza
                            </a>
                            <button type="submit" 
                                    formaction="@Url.Action("DuplicateList", "ToDoLists", new { id = ToDoList.Id })" 
                                    class="btn btn-sm btn-outline-secondary rounded-3 flex-fill fw-medium">
                                Duplica
                            </button>
                            <button type="button" 
                                    class="btn btn-sm btn-outline-danger rounded-3 px-3 lh-1" 
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal-@ToDoList.Id" title="Elimina">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>

                    </div>

                    <div class="modal fade" tabindex="-1" id="deleteModal-@ToDoList.Id">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content border-0 shadow-lg rounded-4">
                                <div class="modal-header border-0 pb-0">
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body text-center py-4">
                                    <i class="bi bi-exclamation-circle text-danger fs-1 d-block mb-2"></i>
                                    <h5 class="fw-bold mb-2">Conferma Eliminazione</h5>
                                    <p class="text-muted mb-0">Sei sicuro di voler eliminare la lista <br/><b>"@ToDoList.Name"</b>?</p>
                                </div>
                                <div class="modal-footer border-0 pt-0 justify-content-center gap-2">
                                    <button type="button" class="btn btn-light rounded-3 px-4" data-bs-dismiss="modal">Annulla</button>
                                    <button type="submit" 
                                            formaction="@Url.Action("Delete", "ToDoLists", new { id = ToDoList.Id })" 
                                            class="btn btn-danger rounded-3 px-4">
                                        Elimina
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            }
        </div>
    }
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const checkboxes = document.querySelectorAll('.list-checkbox');
            const batchActionButtons = document.getElementById('batchActionButtons');

            checkboxes.forEach(box => {
                box.addEventListener('change', function () {
                    const checkedCount = document.querySelectorAll('.list-checkbox:checked').length;
                    
                    if (checkedCount > 0) {
                        batchActionButtons.classList.remove('d-none');
                    } else {
                        batchActionButtons.classList.add('d-none');
                    }
                });
            });
        });
    </script>
}