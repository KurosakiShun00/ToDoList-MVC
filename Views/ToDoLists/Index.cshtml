@using ToDoList_MVC.Models
@model List<ToDoList_MVC.ViewModels.ToDoList.ToDoListsListViewModel>

@{
    ViewData["Title"] = "Index";
    Layout = "_Layout";
    var filteredModel = ViewData["Filter"] != null
        ? ViewData["Filter"]!.Equals("Finished") ? Model.Where(x => x.IsFinished) : Model.Where(x => !x.IsFinished)
        : Model;
}

<div class="d-flex align-items-center justify-content-between mb-4 gap-3">
    <div class="d-flex align-items-center gap-2">
        <h2 class="display-6 mb-0">Le tue Liste</h2>
        <a asp-controller="ToDoLists" asp-action="Index"
           class="btn btn-outline-primary @(ViewData["Filter"] == null ? "active" : "")" role="button">
            Tutti
        </a>
        <a asp-controller="ToDoLists" asp-action="Index" asp-route-filter="Finished"
           class="btn btn-outline-primary @((ViewData["Filter"] != null && ViewData["Filter"]!.Equals("Finished")) ? "active" : "")"
           role="button">
            Filtra per Completate
        </a>
        <a asp-controller="ToDoLists" asp-action="Index" asp-route-filter="Not Finished"
           class="btn btn-outline-primary @((ViewData["Filter"] != null && !ViewData["Filter"]!.Equals("Finished")) ? "active" : "")"
           role="button">
            Filtra per In Corso
        </a>
    </div>

    <div class="d-flex align-items-center gap-2">
        <div class="my-auto">
        <span class="badge bg-light text-dark border fs-6 px-3 py-2 shadow-sm rounded-pill">
            <span class="fw-bold text-primary">@Model.Count</span> / 30 liste
        </span>
        </div>
        
        <a asp-controller="ToDoLists"
           asp-action="Create"
           class="btn btn-primary @(Model.Count() >= 30 ? "disabled" : "")"
           aria-disabled="@(Model.Count() >= 30 ? "true" : "false")"
           tabindex="@(Model.Count() >= 30 ? "-1" : "0")"
           role="button">
            + Crea Nuova Lista
        </a>

        <a asp-controller="Home"
           asp-action="Import"
           class="btn btn-outline-primary @(Model.Count() >= 30 ? "disabled" : "")"
           aria-disabled="@(Model.Count() >= 30 ? "true" : "false")"
           tabindex="@(Model.Count() >= 30 ? "-1" : "0")"
           role="button">
            ⬆ Importa Lista
        </a>
    </div>
</div>

@if (filteredModel.Count() == 0)
{
    <div class="col-12 text-center text-muted py-5 fw-bold">
        NON HAI LISTE, CREANE UNA PER VISUALIZZARLA QUA
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var ToDoList in filteredModel)
        {
            <div class="col d-flex">
                <div
                    class="card @(ToDoList.IsFinished ? "border-secondary" : "border-success") shadow-sm w-100 h-100 d-flex flex-column">
                    <div
                        class="card-header bg-transparent @(ToDoList.IsFinished ? "border-secondary" : "border-success") d-flex align-items-center justify-content-between py-3">
                        <div class="d-flex">
                            <h5 class="card-title @(ToDoList.IsFinished ? "text-secondary" : "text-success") mb-0 text-truncate me-2"
                                title="@ToDoList.Name">
                                @ToDoList.Name
                            </h5>
                            @if (!ToDoList.IsFinished)
                            {
                                <span class="badge rounded-pill text-bg-primary align-content-center">In corso</span>
                            }
                            else
                            {
                                <span
                                    class="badge rounded-pill text-bg-secondary align-content-center">Completata</span>
                            }
                        </div>
                        <a asp-controller="ToDoLists" asp-action="Edit" asp-route-id="@ToDoList.Id"
                           class="btn btn-sm btn-outline-primary flex-shrink-0" title="Modifica">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                 class="bi bi-pencil" viewBox="0 0 16 16">
                                <path
                                    d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                            </svg>
                        </a>
                    </div>

                    <div class="card-body flex-grow-1 d-flex flex-column justify-content-center"
                         style="min-height: 160px;">
                        @if (ToDoList.ToDos.Count == 0)
                        {
                            <p class="text-muted text-center m-0 fst-italic">
                                Nessuna attività presente
                            </p>
                        }
                        else
                        {
                            <div class="w-100 my-auto">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <small class="text-muted fw-bold text-uppercase"
                                           style="font-size: 0.75rem; letter-spacing: 0.5px;">Anteprima</small>
                                    <span class="badge bg-light text-dark border">@ToDoList.ToDos.Count elementi</span>
                                </div>

                                <ul class="list-group list-group-flush mb-1">
                                    @foreach (var toDo in ToDoList.ToDos.Take(3))
                                    {
                                        <li class="list-group-item px-0 py-1 d-flex align-items-center bg-transparent border-0">
                                            <span class="me-2 text-muted">•</span>
                                            @if (toDo.IsCompleted)
                                            {
                                                <span
                                                    class="text-decoration-line-through text-muted text-truncate">@toDo.Name</span>
                                            }
                                            else
                                            {
                                                <span class="text-truncate">@toDo.Name</span>
                                            }
                                        </li>
                                    }
                                </ul>

                                @if (ToDoList.ToDos.Count > 3)
                                {
                                    <div class="text-end">
                                        <small class="text-muted fst-italic">+
                                            altri @(ToDoList.ToDos.Count - 3)...</small>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div
                        class="card-footer bg-transparent border-success d-flex justify-content-between align-items-center gap-2 py-3">
                        <a asp-controller="ToDoLists" asp-action="Details" asp-route-id="@ToDoList.Id"
                           class="btn btn-outline-primary btn-sm w-100" role="button">
                            Visualizza
                        </a>
                        <form asp-controller="ToDoLists" asp-action="DuplicateList" asp-route-id="@ToDoList.Id" method="post" class="w-100">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-warning btn-sm w-100">
                                Duplica
                            </button>
                        </form>
                        <button type="button" class="btn btn-outline-danger btn-sm w-100" data-bs-toggle="modal"
                                data-bs-target="#deleteModal-@ToDoList.Id">
                            Cancella
                        </button>
                    </div>

                </div>
                <div class="modal" tabindex="-1" id="deleteModal-@ToDoList.Id">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Conferma Eliminazione</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                        aria-label="Close"></button>
                            </div>
                            <div class="modal-body justify-content-center text-center">
                                <p>Sei sicuro di voler eliminare per sempre la lista <br/>
                                    <b>"@ToDoList.Name?"</b></p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Annulla</button>
                                <form asp-controller="ToDoLists" asp-action="Delete" asp-route-id="@ToDoList.Id"
                                      method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger">
                                        Conferma Eliminazione
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}