@model ToDoList_MVC.ViewModels.ToDoList.ToDoListsDetailsViewModel;

@{
    ViewData["Title"] = "Detail";
    Layout = "_Layout";
}

<h2 class="display-4 mb-4">@Model.Name</h2>

<table class="table align-middle">
    <thead class="table-dark">
        <tr>
            <th scope="col" style="width: 10%;">Id</th>
            <th scope="col">Nome Attività</th>
            <th scope="col" style="width: 15%;" class="text-center">Completata</th>
            <th scope="col" style="width: 15%;" class="text-end">Azioni</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var line in Model.ToDos)
    {
        <tr>
            <td>@line.Id</td>
            
<td>
    <form asp-controller="ToDoLists" asp-action="EditToDo" asp-route-id="@line.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ToDoListId" value="@Model.Id" />
        
        <input type="text" 
               name="Name" 
               value="@line.Name" 
               class="form-control form-control-sm bg-transparent border-0 shadow-none @(line.IsCompleted ? "text-decoration-line-through text-muted" : "")" 
               onmouseenter="if(document.activeElement!==this){ this.classList.remove('bg-transparent','border-0'); this.classList.add('bg-light','border-secondary-subtle'); }"
               onmouseleave="if(document.activeElement!==this){ this.classList.remove('bg-light','border-secondary-subtle'); this.classList.add('bg-transparent','border-0'); }"
               onfocus="this.classList.remove('bg-transparent','bg-light','border-0','border-secondary-subtle'); this.classList.add('bg-white','border-primary');"
               onblur="this.classList.remove('bg-white','border-primary'); this.classList.add('bg-transparent','border-0');"
               onchange="this.form.submit()" />
    </form>
</td>
            
            <td class="text-center">
                <form asp-controller="ToDoLists" asp-action="ToggleToDo" asp-route-id="@line.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="toDoListId" value="@Model.Id" />
                    
                    <input class="form-check-input" 
                           type="checkbox" 
                           @(line.IsCompleted ? "checked" : "") 
                           onchange="this.form.submit()" />
                </form>
            </td>

            <td class="text-end">
                <form asp-controller="ToDoLists" asp-action="DeleteToDo" asp-route-id="@line.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm">
                        Elimina
                    </button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

<p class="text-end fw-bold fs-4">Cose da fare rimaste : @Model.Remaining</p>
<hr />

<div class="d-flex align-items-center justify-content-between mb-4 gap-3">
    <a asp-controller="ToDoLists" asp-action="Index" class="btn btn-secondary" role="button">
        ← Torna alla Lista
    </a>

    <div class="d-flex gap-2">
        <a asp-controller="ToDoLists" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary" role="button">
            Modifica Nome Lista
        </a>

        <a asp-controller="ToDoLists" asp-action="CreateToDo" asp-route-id="@Model.Id" class="btn btn-primary" role="button">
            + Aggiungi Attività
        </a>
    </div>
</div>