@model ToDoList_MVC.ViewModels.ToDoList.ToDoListsDetailsViewModel

@{
    ViewData["Title"] = "Dettaglio Lista";
    Layout = "_Layout";

    var ListDescription = Model.Description ?? "Nessuna descrizione fornita.";
}

<form asp-controller="ToDoLists" method="post" id="batchForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="toDoListId" value="@Model.Id" />
</form>

@foreach (var line in Model.ToDos)
{
    <form id="editForm-@line.Id" asp-controller="ToDoLists" asp-action="EditToDo" asp-route-id="@line.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ToDoListId" value="@Model.Id"/>
    </form>

    <form id="toggleForm-@line.Id" asp-controller="ToDoLists" asp-action="ToggleToDo" asp-route-id="@line.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="toDoListId" value="@Model.Id"/>
    </form>

    <form id="deleteForm-@line.Id" asp-controller="ToDoLists" asp-action="DeleteToDo" asp-route-id="@line.Id" method="post">
        @Html.AntiForgeryToken()
    </form>
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center gap-2">
        <h2 class="display-4 m-0">@Model.Name</h2>

        <a asp-controller="ToDoLists" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary flex-shrink-0" title="Modifica">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
            </svg>
        </a>

        <a tabindex="0"
           class="btn btn-info btn-sm ms-2"
           role="button"
           data-bs-toggle="popover"
           data-bs-trigger="focus"
           data-bs-placement="right"
           title="Info Lista"
           data-bs-content="@ListDescription">
            Descrizione
        </a>
    </div>

    <div id="batchActionsBar" class="d-none d-flex gap-2">
        <button type="submit"
                form="batchForm"
                formaction="@Url.Action("MultipleToDoFinished", "ToDoLists")"
                class="btn btn-sm btn-success">
            Segna come Completate
        </button>
        <button type="submit"
                form="batchForm"
                formaction="@Url.Action("MultipleToDoNotFinished", "ToDoLists")"
                class="btn btn-sm btn-warning">
            Segna come non Completate
        </button>
        <button type="submit"
                form="batchForm"
                formaction="@Url.Action("MultipleToDoDelete", "ToDoLists")"
                class="btn btn-sm btn-danger"
                onclick="return confirm('Sei sicuro di voler eliminare le attività selezionate?');">
            Elimina Selezionate
        </button>
    </div>
</div>

<table class="table align-middle">
    <thead class="table-dark">
    <tr>
        <th style="width: 5%;">
            <input type="checkbox" id="selectAll" class="form-check-input fs-5 mt-0" title="Seleziona tutti" />
        </th>
        <th scope="col" style="width: 10%;">Id</th>
        <th scope="col">Nome Attività</th>
        <th scope="col" style="width: 15%;" class="text-center">Completata</th>
        <th scope="col" style="width: 15%;" class="text-center">Categoria</th>
        <th scope="col" style="width: 15%;" class="text-end">Elimina Attività</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var line in Model.ToDos)
    {
        <tr style="--bs-table-bg: @line.LineColor">
            <td>
                <input type="checkbox" name="selectedIds" value="@line.Id"
                       form="batchForm"
                       class="form-check-input list-checkbox fs-5 mt-0 me-1"
                       title="Seleziona attività" />
            </td>
            <td>@line.Id</td>
            <td>
                <input type="text"
                       form="editForm-@line.Id"
                       name="Name"
                       value="@line.Name"
                       class="form-control form-control-sm bg-transparent border-0 shadow-none @(line.IsCompleted ? "text-decoration-line-through text-muted" : "")"
                       onmouseenter="if(document.activeElement!==this){ this.classList.remove('bg-transparent','border-0'); this.classList.add('bg-light','border-secondary-subtle'); }"
                       onmouseleave="if(document.activeElement!==this){ this.classList.remove('bg-light','border-secondary-subtle'); this.classList.add('bg-transparent','border-0'); }"
                       onfocus="this.classList.remove('bg-transparent','bg-light','border-0','border-secondary-subtle'); this.classList.add('bg-white','border-primary');"
                       onblur="this.classList.remove('bg-white','border-primary'); this.classList.add('bg-transparent','border-0');"
                       onchange="document.getElementById('editForm-@line.Id').submit()"/>
            </td>

            <td class="text-center">
                <input class="form-check-input"
                       type="checkbox"
                       form="toggleForm-@line.Id"
                       @(line.IsCompleted ? "checked" : "")
                       onchange="document.getElementById('toggleForm-@line.Id').submit()"/>
            </td>

            <td class="text-center">
                <select name="CategoryId"
                        form="editForm-@line.Id"
                        class="form-select form-select-sm"
                        onchange="document.getElementById('editForm-@line.Id').submit()">
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Value" selected="@(category.Value == line.CategoryId.ToString())">
                            @category.Text
                        </option>
                    }
                </select>
            </td>

            <td class="text-end">
                <button type="submit" form="deleteForm-@line.Id" class="btn btn-danger btn-sm">
                    X
                </button>
            </td>
        </tr>
    }
    </tbody>
</table>

<p class="text-end fw-bold fs-4">Cose da fare rimaste: @Model.Remaining</p>
<hr />

<div class="d-flex align-items-center justify-content-between mb-4 gap-3">
    <a asp-controller="ToDoLists" asp-action="Index" class="btn btn-secondary" role="button">
        ← Torna alla Lista
    </a>
    <a asp-controller="ToDoLists" asp-action="ExportList" asp-route-id="@Model.Id" class="btn btn-primary" role="button">
        ⬇ Scarica Lista (.txt)
    </a>
    <div class="d-flex gap-2">
        <a asp-controller="ToDoLists" asp-action="CreateToDo" asp-route-id="@Model.Id" class="btn btn-primary" role="button">
            + Aggiungi Attività
        </a>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var popoverElement = document.querySelector('[data-bs-toggle="popover"]');
        if (popoverElement && typeof bootstrap !== 'undefined') {
            new bootstrap.Popover(popoverElement);
        }

        const checkboxes = document.querySelectorAll('.list-checkbox');
        const batchActionsBar = document.getElementById('batchActionsBar');
        const selectAll = document.getElementById('selectAll');

        function toggleBatchBar() {
            const checkedCount = document.querySelectorAll('.list-checkbox:checked').length;
            if (batchActionsBar) {
                if (checkedCount > 0) {
                    batchActionsBar.classList.remove('d-none');
                } else {
                    batchActionsBar.classList.add('d-none');
                }
            }
        }

        checkboxes.forEach(box => {
            box.addEventListener('change', toggleBatchBar);
        });

        if (selectAll) {
            selectAll.addEventListener('change', function () {
                checkboxes.forEach(box => {
                    box.checked = selectAll.checked;
                });
                toggleBatchBar();
            });
        }
    });
</script>
}