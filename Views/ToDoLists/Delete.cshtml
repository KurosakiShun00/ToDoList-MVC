@model ToDoList_MVC.ViewModels.ToDoListsDetailsViewModel;

@{
    ViewData["Title"] = "Delete Confirmation";
    Layout = "_Layout";
}

<div class="card-body">
    <dl class="row mb-0">

        <dt class="col-sm-3 text-muted">ID Lista</dt>
        <dd class="col-sm-9">@Model.Id</dd>

        <dt class="col-sm-3 text-muted">Nome Lista</dt>
        <dd class="col-sm-9 fw-bold">@Model.Name</dd>

    </dl>
</div>

<hr />
<h2 class="display-4">Cose Da Fare Nella Lista Da Cancellare</h2>
<table class="table">
    <thead class="thead-dark">
    <tr>
        <th scope="col">Id Attività</th>
        <th scope="col">Nome Attività</th>
        <th scope="col">Stato Attività</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var line in Model.ToDos)
    {
        <tr>
            <td>@line.Id</td>
            <td>@line.Name</td>
            <td>@(line.IsCompleted ? "Completata" : "Da Completare")</td>
        </tr>
    }
    </tbody>
</table>
<p class="text-end fw-bold fs-4">Cose da fare rimaste : @Model.Remaining</p>
<hr />



<div>
    <a asp-controller="ToDoLists" asp-action="Index" class="btn btn-primary" role="button">
        Annulla
    </a>

    <form asp-controller="ToDoLists" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">
            Conferma Eliminazione
        </button>
    </form>

</div>