@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Verifica Codice di Recupero";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6 col-xl-5">
        <div class="card shadow-sm border-0 rounded-3 my-4">
            <div class="card-body p-4 p-md-5">

                <div class="mb-4 text-center">
                    <div class="d-inline-flex align-items-center justify-content-center bg-warning-subtle text-warning-emphasis rounded-circle mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-key-fill fs-2"></i>
                    </div>
                    <h3 class="fw-bold text-primary mb-1">Codice di Recupero</h3>
                    <p class="text-muted small">Usa uno dei tuoi codici monouso per accedere all'account</p>
                </div>

                <div class="alert alert-warning border-0 rounded-3 p-3 mb-4 small text-dark d-flex align-items-start gap-3">
                    <i class="bi bi-exclamation-triangle-fill fs-5 text-warning flex-shrink-0"></i>
                    <div>
                        <strong class="d-block mb-1">Nota importante:</strong>
                        Questo accesso non ricorderà il dispositivo fino a quando non inserisci un codice valido dall'app di autenticazione o disabiliti la 2FA.
                    </div>
                </div>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small" role="alert"></div>

                    <div class="form-floating mb-4">
                        <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="Codice di recupero" autofocus />
                        <label asp-for="Input.RecoveryCode" class="form-label">Codice di Recupero</label>
                        <span asp-validation-for="Input.RecoveryCode" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="w-100 btn btn-primary rounded-3 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-box-arrow-in-right"></i> Accedi
                    </button>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}