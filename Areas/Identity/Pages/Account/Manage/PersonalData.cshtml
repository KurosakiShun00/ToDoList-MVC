@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Dati personali";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3 class="mb-4">@ViewData["Title"]</h3>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <p>
            Il tuo account contiene dati personali che ci hai fornito. Questa pagina ti permette di scaricare o eliminare definitivamente tali dati.
        </p>

        <div class="alert alert-warning" role="alert">
            <strong>Attenzione:</strong> L'eliminazione di questi dati rimuoverà permanentemente il tuo account e questa azione non potrà essere annullata.
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <form id="download-data" asp-page="DownloadPersonalData" method="post" class="d-inline">
                <button class="btn btn-primary" type="submit">Scarica dati</button>
            </form>
            <a id="delete" asp-page="DeletePersonalData" class="btn btn-outline-danger">Elimina account</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}