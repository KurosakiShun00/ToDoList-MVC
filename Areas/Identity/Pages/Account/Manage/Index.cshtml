@page
@model IndexModel
@{
    ViewData["Title"] = "Il Tuo Profilo";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="row w-100 m-0">
    <div class="col-12 p-0">
        <div class="card shadow-sm border-0 rounded-3 my-2 w-100">
            <div class="card-body p-4 p-md-5">

                <div class="mb-4">
                    <h3 class="fw-bold text-primary mb-1">@ViewData["Title"]</h3>
                    <p class="text-muted small">Gestisci i tuoi dati personali</p>
                </div>

                <partial name="_StatusMessage" for="StatusMessage" />

                <form id="profile-form" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Username" class="form-control bg-light" placeholder="Username" disabled />
                        <label asp-for="Username" class="form-label text-muted">
                            <i class="bi bi-person-badge me-1"></i> Username
                        </label>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Input.Nome" class="form-control" placeholder="Inserisci il tuo nome." />
                                <label asp-for="Input.Nome" class="form-label">
                                    <i class="bi bi-person me-1"></i> Nome
                                </label>
                                <span asp-validation-for="Input.Nome" class="text-danger small ms-1"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Input.Cognome" class="form-control" placeholder="Inserisci il tuo cognome." />
                                <label asp-for="Input.Cognome" class="form-label">
                                    <i class="bi bi-person me-1"></i> Cognome
                                </label>
                                <span asp-validation-for="Input.Cognome" class="text-danger small ms-1"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.NickName" class="form-control" placeholder="Inserisci il tuo NickName." />
                        <label asp-for="Input.NickName" class="form-label">
                            <i class="bi bi-at me-1"></i> NickName
                        </label>
                        <span asp-validation-for="Input.NickName" class="text-danger small ms-1"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Inserisci il tuo numero di telefono." />
                        <label asp-for="Input.PhoneNumber" class="form-label">
                            <i class="bi bi-telephone me-1"></i> Numero di Telefono
                        </label>
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger small ms-1"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <select asp-for="Input.Sesso" class="form-select">
                                    <option value="0">Maschio</option>
                                    <option value="1">Femmina</option>
                                    <option value="2">Non Specificato</option>
                                </select>
                                <label asp-for="Input.Sesso" class="form-label">
                                    <i class="bi bi-gender-ambiguous me-1"></i> Sesso
                                </label>
                                <span asp-validation-for="Input.Sesso" class="text-danger small ms-1"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Input.DataDiNascita" type="date" class="form-control" placeholder="Data di nascita" />
                                <label asp-for="Input.DataDiNascita" class="form-label">
                                    <i class="bi bi-calendar-event me-1"></i> Data di Nascita
                                </label>
                                <span asp-validation-for="Input.DataDiNascita" class="text-danger small ms-1"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button id="update-profile-button" type="submit" class="btn btn-primary btn-lg shadow-sm">
                            <i class="bi bi-check-circle me-1"></i> Salva Modifiche
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}