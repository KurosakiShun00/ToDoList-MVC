@page
@model ShowRecoveryCodesModel
@{
    ViewData["Title"] = "Codici di Recupero";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="col-12 p-0">
    <div class="card shadow-sm border-0 rounded-3 my-2 w-100">
        <div class="card-body p-4 p-md-5">
            
            <div class="mb-4">
                <h3 class="fw-bold text-primary mb-1">Codici di Recupero</h3>
                <p class="text-muted small">Conserva questi codici in un luogo sicuro ed accessibile solo a te</p>
            </div>

            <div class="alert alert-warning border-0 rounded-3 p-3 mb-4 small text-dark d-flex align-items-start gap-3">
                <i class="bi bi-exclamation-triangle-fill fs-5 text-warning flex-shrink-0"></i>
                <div>
                    <strong class="d-block mb-1">Attenzione: Salva questi codici ora!</strong>
                    Se perdi l'accesso al tuo dispositivo e non disponi dei codici di recupero, non potrai più accedere al tuo account.
                </div>
            </div>

            <div class="bg-light p-4 rounded-3 border mb-4">
                <div class="row g-2 justify-content-center">
                    @for (var row = 0; row < Model.RecoveryCodes.Length; row++)
                    {
                        <div class="col-6 col-sm-4 col-md-3">
                            <div class="bg-white p-2 border rounded-3 text-center shadow-sm">
                                <code class="fw-bold text-dark fs-6 user-select-all">@Model.RecoveryCodes[row]</code>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <a asp-page="./TwoFactorAuthentication" class="w-100 btn btn-primary rounded-3 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-shield-check"></i> Ho salvato i codici
            </a>

        </div>
    </div>
</div>