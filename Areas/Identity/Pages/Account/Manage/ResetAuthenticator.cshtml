@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Reset Chiave Autenticatore";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>Se ripristini la tua chiave dell'app di autenticazione dovrai reimpostarla per proteggere il tuo account.</strong>
    </p>
    <p>
        Questo processo disabilità l'autenticazione a due fattori.
    </p>
</div>
<div>
    <form id="reset-authenticator-form" method="post">
        <button id="reset-authenticator-button" class="btn btn-danger" type="submit">Reset Chiave di Autenticazione</button>
    </form>
</div>
