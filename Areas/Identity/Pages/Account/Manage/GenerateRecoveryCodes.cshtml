@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Genera i codici di recupero dell'autenticazione a due fattori (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>Conserva questi codici con cura.</strong>
    </p>
    <p>
        Se perdi sia il tuo dispositivo che questi codici, potresti perdere l'accesso al nostro servizio.
    </p>
    <p>
        Generare nuovi codici di recupero non cambia la chiave utilizzata sull'app di autenticazione. Se desideri cambiare la chiave
        utilizzata nell'app di autenticazione dovresti <a asp-page="./ResetAuthenticator">resettare la tua chiave di autenticazione.</a>
    </p>
</div>
<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">Genera codici di recupero</button>
    </form>
</div>
