@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Cambia Password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<partial name="_StatusMessage" for="StatusMessage"/>

<div class="col-12 p-0">
    <div class="card shadow-sm border-0 rounded-3 my-2 w-100">
        <div class="card-body p-4 p-md-5">
            <div class="mb-4">
                <h3 class="fw-bold text-primary mb-1">Password</h3>
                <p class="text-muted small">Modifica la password del tuo account</p>
            </div>
            <form id="change-password-form" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password"
                           aria-required="true" placeholder="Password attuale"/>
                    <label asp-for="Input.OldPassword" class="form-label">Password attuale</label>
                    <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password"
                           aria-required="true" placeholder="Nuova password"/>
                    <label asp-for="Input.NewPassword" class="form-label">Nuova password</label>
                    <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password"
                           aria-required="true" placeholder="Conferma nuova password"/>
                    <label asp-for="Input.ConfirmPassword" class="form-label">Conferma nuova password</label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit"
                        class="w-100 btn btn-primary rounded-3 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-key-fill"></i> Aggiorna Password
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}