@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Configura App di Autenticazione";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage"/>

<div class="col-12 p-0">
    <div class="card shadow-sm border-0 rounded-3 my-2 w-100">
        <div class="card-body p-4 p-md-5">

            <div class="mb-4">
                <h3 class="fw-bold text-primary mb-1">Configura App di Autenticazione</h3>
                <p class="text-muted small">Proteggi il tuo account abilitando l'autenticazione a due fattori (2FA)</p>
            </div>

            <!-- Download App Hint -->
            <div class="alert alert-light border rounded-3 p-3 mb-4 small text-muted">
                <div class="d-flex align-items-center gap-2 mb-1 fw-semibold text-dark">
                    <i class="bi bi-phone text-primary fs-5"></i>
                    <span>Non hai ancora un'app 2FA?</span>
                </div>
                Scarica un'app come Microsoft Authenticator (
                <a href="https://go.microsoft.com/fwlink/?Linkid=825072" target="_blank"
                   class="text-primary fw-semibold">Android</a> /
                <a href="https://go.microsoft.com/fwlink/?Linkid=825073" target="_blank"
                   class="text-primary fw-semibold">iOS</a>) o Google Authenticator (
                <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=it"
                   target="_blank" class="text-primary fw-semibold">Android</a> /
                <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8" target="_blank"
                   class="text-primary fw-semibold">iOS</a>).
            </div>

            <!-- QR Code Section -->
            <div class="text-center bg-light p-4 rounded-3 border mb-4">
                <p class="text-muted small mb-3">Scansiona questo codice QR con la tua app di autenticazione:</p>

                <div class="d-flex justify-content-center mb-3">
                    <div class="p-3 bg-white rounded-3 border shadow-sm d-inline-block">
                        <div id="qrCode"></div>
                    </div>
                </div>
                <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>

                <p class="text-muted small mb-1">Oppure inserisci manualmente la chiave di verifica:</p>
                <div class="d-inline-block bg-white px-3 py-2 rounded-3 border">
                    <code class="fw-bold text-dark fs-6 user-select-all">@Model.SharedKey</code>
                </div>
            </div>

            <!-- Verification Form -->
            <form id="send-code" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Code" class="form-control" autocomplete="off"
                           placeholder="Codice di verifica"/>
                    <label asp-for="Input.Code" class="form-label">Codice di verifica 2FA</label>
                    <span asp-validation-for="Input.Code" class="text-danger small"></span>
                </div>

                <button type="submit"
                        class="w-100 btn btn-primary rounded-3 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-shield-check"></i> Verifica e Attiva
                </button>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
    <script type="text/javascript" src="~/lib/QRCode/qrcode.js"></script>
    <script type="text/javascript" src="~/js/qr.js"></script>
}